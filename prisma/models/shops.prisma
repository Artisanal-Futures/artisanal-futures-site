model Shop {
  id               String            @id @default(cuid())
  ownerName        String
  bio              String?
  description      String?
  ownerPhoto       String?
  logoPhoto        String?
  coverPhoto       String?
  phone            String?
  email            String?
  website          String?
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attributeTags    String[]
  name             String
  isPublic         Boolean           @default(true)

  /// Public profile URL is /shops/{slug}. Optional until every shop is
  /// backfilled (scripts/backfill-shop-slugs.ts). Old slugs keep 301ing.
  slug             String?           @unique
  previousSlugs    String[]
  /// Artisan-editable profile links (Instagram, Facebook, Etsy, ...). Feed the
  /// shop's schema.org `sameAs`.
  socialLinks      String[]

  /// How precisely the shop's location is shown publicly. STOREFRONT pins the
  /// street address and shows it on the profile; HOME_BASED keeps the street
  /// private and pins the general area; AREA only ever stores a locality.
  locationType     ShopLocationType  @default(HOME_BASED)

  /// Admin-only search/share overrides. Blank = derived from the profile.
  seoTitle         String?
  seoDescription   String?
  seoImage         String?
  seoNoIndex       Boolean           @default(false)

  /// Scheduled product-sync configuration. `syncPlatform` reuses the
  /// per-product scrape enum so there is one platform vocabulary; shops on
  /// SQUARE or MANUAL simply leave `syncEnabled` false and the cron skips them.
  syncPlatform        ProductScrapeMethod?
  syncEnabled         Boolean             @default(false)
  /// Overrides `website` for feed fetching. Squarespace in particular needs the
  /// *products page* URL, not the homepage.
  syncUrl             String?
  /// Permits a plain-HTTP origin for storefronts without a working certificate.
  /// safe-fetch's private-IP, redirect and size guards still apply.
  allowInsecureOrigin Boolean             @default(false)
  lastSyncedAt        DateTime?

  events           Event[]
  products         Product[]
  services         Service[]
  invites          PlatformInvite[]  @relation("ShopInvites")
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: NoAction)
  address          ShopAddress?
  websiteProvision WebsiteProvision?
  syncRuns         ProductSyncRun[]
  privateContact   ShopPrivateContact?
}

model ShopAddress {
  id         String  @id @default(cuid())
  address    String?
  additional String?
  city       String?
  state      String?
  zip        String?
  country    String?
  shopId     String? @unique
  street     String?
  shop       Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  latitude     Float?
  longitude    Float?
  /// Normalized query last geocoded, prefixed with its mode:
  /// `mode=locality|zip=...` (zip/city/state/country only), or for a
  /// STOREFRONT `mode=street|street=...|zip=...`. Never returned publicly.
  geocodeQuery String?
  geocodedAt   DateTime?
  /// What the stored coordinates resolve to: "street" (exact storefront pin)
  /// or "locality" (zip/city centroid).
  geocodePrecision String?
}

enum ShopLocationType {
  STOREFRONT
  HOME_BASED
  AREA
}

/// Admin-only private contact for the artisan behind a shop. Kept in its own
/// table so it is never returned by queries that include/spread a Shop row.
model ShopPrivateContact {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String?
  email       String?
  phone       String?
  notes       String?  @db.Text
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
