/// Site-wide search/share settings, edited at /admin/seo. Singleton: id "default".
model SiteSettings {
  id                 String   @id @default("default")
  siteName           String   @default("Artisanal Futures")
  alternateNames     String[]
  tagline            String?
  defaultTitle       String?
  defaultDescription String?
  defaultOgImage     String?
  logo               String?
  contactEmail       String?
  /// Organization profiles (social, Wikidata, ...). Feed schema.org `sameAs`.
  socialLinks        String[]
  twitterHandle      String?
  googleVerification String?
  bingVerification   String?
  allowAiCrawlers    Boolean  @default(true)
  /// Markdown intro for /llms.txt.
  llmsIntro          String?
  updatedAt          DateTime @updatedAt
}

/// Admin overrides for a static public page's metadata, keyed by path ("/about-us").
model PageSeo {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  ogImage     String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}
